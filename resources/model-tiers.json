{
  "_doc": "Single source of truth for per-skill and per-agent model+effort tiering. Edit this, then run scripts/registration/sync-model-tiers.py --apply (or just commit; the pre-commit hook applies it). Full docs: resources/model-tiers.md",
  "tiers": {
    "T1": {
      "model": "haiku",
      "effort": "low",
      "_meaning": "Lookup. No reasoning. File search, status, how-to."
    },
    "T2": {
      "model": "sonnet",
      "effort": "medium",
      "_meaning": "Mechanical. Narrow, well-defined scope."
    },
    "T3": {
      "model": "sonnet",
      "effort": "high",
      "_meaning": "Standard build. Context-aware. Default tier for unlisted skills (session default lives in settings.json)."
    },
    "T4": {
      "model": "opus",
      "effort": "xhigh",
      "_meaning": "Deep reasoning. Architecture, complex debug, planning."
    }
  },
